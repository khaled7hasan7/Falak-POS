# ---------------------------------------------------------------------
# Falak POS — نسخة عن متغيرات البيئة. انسخ هذا الملف إلى .env وعدّله.
# ---------------------------------------------------------------------

# قاعدة البيانات المحلية (PostgreSQL 16 — الملف 02)
# ملاحظة: المنفذ 5433 لأن 5432 مشغول بنسخة PostgreSQL أخرى على هذا الجهاز
DATABASE_URL=postgres://falak:falak_dev@localhost:5433/falak_pos

# قاعدة الاختبارات (تُبنى وتُهدم في كل تشغيل)
TEST_DATABASE_URL=postgres://falak:falak_dev@localhost:5433/falak_pos_test

# الوكيل المحلي (apps/agent)
AGENT_PORT=5111
AGENT_HOST=0.0.0.0

# سر توقيع جلسات الوكيل المحلية — يُولَّد عشوائياً عند التثبيت الحقيقي
AGENT_JWT_SECRET=dev_only_change_me_min_32_chars_long_string
AGENT_SESSION_TTL_HOURS=12

# الواجهة (apps/pos)
VITE_AGENT_URL=http://localhost:5111
